  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#00F2FE>\u25CF \u0423\u041F\u0420\u0410\u0412\u041B\u0415\u041D\u0418\u0415 \u041D\u0410 \u041F\u041A (\u041A\u041B\u0410\u0412\u0418\u0410\u0422\u0423\u0420\u0410 \u0418 \u041C\u042B\u0428\u042C):</color>\n  \u2022 [W][A][S][D] \u2014 \u041F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u0432\u0430\u0448\u0435\u0433\u043E \u0442\u0430\u043D\u043A\u0430\n  \u2022 [\u041C\u044B\u0448\u044C] \u2014 \u041D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0431\u0430\u0448\u043D\u0438 \u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u0435\n  \u2022 [\u041B\u041A\u041C] \u2014 \u0421\u0442\u0440\u0435\u043B\u044C\u0431\u0430 \u0441\u043D\u0430\u0440\u044F\u0434\u0430\u043C\u0438\n  \u2022 [1] ... [5] \u2014 \u041C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u0430\u044F \u043F\u0440\u043E\u043A\u0430\u0447\u043A\u0430 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A \u0432 \u0431\u043E\u044E\n\n<color=#FF9500>\u25CF \u0423\u041F\u0420\u0410\u0412\u041B\u0415\u041D\u0418\u0415 \u041D\u0410 \u041C\u041E\u0411\u0418\u041B\u042C\u041D\u042B\u0425 \u0423\u0421\u0422\u0420\u041E\u0419\u0421\u0422\u0412\u0410\u0425:</color>\n  \u2022 \u041B\u0435\u0432\u044B\u0439 \u0434\u0436\u043E\u0439\u0441\u0442\u0438\u043A \u2014 \u041F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u043F\u043E \u0430\u0440\u0435\u043D\u0435\n  \u2022 \u041F\u0440\u0430\u0432\u044B\u0439 \u0434\u0436\u043E\u0439\u0441\u0442\u0438\u043A \u2014 \u041F\u0440\u0438\u0446\u0435\u043B \u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043E\u0433\u043E\u043D\u044C\n\n<color=#10B981>\u25CF \u0426\u0415\u041B\u042C \u0418\u0413\u0420\u042B \u0418 \u041F\u0420\u0410\u0412\u0418\u041B\u0410 \u0411\u041E\u042F:</color>\n  \u2022 \u0412\u0430\u0448\u0430 \u0446\u0435\u043B\u044C \u2014 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0435 \u0431\u0430\u0448\u043D\u0438 \u0438 \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0443\u044E \u0426\u0438\u0442\u0430\u0434\u0435\u043B\u044C.\n  \u2022 \u0417\u0430 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0438\u0435 \u043A\u0440\u0438\u043F\u043E\u0432 \u0438 \u0432\u0440\u0430\u0433\u043E\u0432 \u0432\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435 \u043E\u043F\u044B\u0442 \u0438 \u043F\u0440\u043E\u043A\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0435 \u043F\u0435\u0440\u043A\u0438.\n  \u2022 \u0421\u043E\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0435 \u0420\u0443\u043D\u044B \u043D\u0430 \u0430\u0440\u0435\u043D\u0435 \u0434\u043B\u044F \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445 \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u0439!"
